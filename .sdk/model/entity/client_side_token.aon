# Entity: client_side_token

main: kit: entity: client_side_token: {

  alias: field: {}

  fields: [
    {
      name: "action"
      req: true
      short: "The action that the token should permit"
      type: "`$STRING`"
    }
    {
      name: "expiry"
      req: false
      short: "The expiry of the token in milliseconds format."
      type: "`$INTEGER`"
    }
    {
      name: "payload"
      req: false
      short: "The payload that the token must be used with"
      type: "`$OBJECT`"
    }
  ]

  name: "client_side_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/client-side-tokens"
          segments: [
            {
              lit: "client-side-tokens"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
