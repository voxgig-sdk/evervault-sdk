          }
          contract: {
            id: "POST /payments/network-tokens/{network_token_id}/simulate"
            json: "{\"operationId\":\"simulateNetworkTokenUpdate\",\"parameters\":[{\"description\":\"The id of the Network Token\",\"in\":\"path\",\"name\":\"network_token_id\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"NewCardExpiryAndLastFourExample\":{\"value\":{\"updateType\":\"new-card-expiry-and-last-four\"}},\"NewTokenExpiryAndNumberExample\":{\"value\":{\"updateType\":\"new-token-expiry-and-number\"}},\"NewTokenStatusExample\":{\"value\":{\"updateType\":\"new-token-status\"}}},\"schema\":{\"properties\":{\"updateType\":{\"description\":\"The type of update to simulate.\",\"enum\":[\"new-token-status\",\"new-card-expiry-and-last-four\",\"new-token-expiry-and-number\"],\"type\":\"string\"}},\"type\":\"object\"}}}},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"DeactivateTokenExample\":{\"summary\":\"Inactive token\",\"value\":{\"card\":{\"brand\":\"visa\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"lastFour\":\"4242\"},\"createdAt\":1692972623233,\"expiry\":{\"month\":\"13\",\"year\":\"25\"},\"id\":\"network_token_eead1d640d7c\",\"merchant\":\"merchant_ddsaJsda9d86\",\"number\":\"4498004918463434\",\"paymentAccountReference\":\"512381d9f8e0629211e3949a08002\",\"status\":\"inactive\",\"tokenRequestorIdentifier\":\"40020248564\",\"tokenServiceProvider\":\"vts\",\"updatedAt\":1692972623768}},\"NewCardExpiryAndLastFourExample\":{\"summary\":\"New card expiry and last four\",\"value\":{\"card\":{\"brand\":\"visa\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"lastFour\":\"4242\"},\"createdAt\":1692972623233,\"expiry\":{\"month\":\"13\",\"year\":\"25\"},\"id\":\"network_token_eead1d640d7c\",\"merchant\":\"merchant_ddsaJsda9d86\",\"number\":\"4498004918463434\",\"paymentAccountReference\":\"512381d9f8e0629211e3949a08002\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40020248564\",\"tokenServiceProvider\":\"vts\",\"updatedAt\":1692972623768}},\"NewTokenExpiryAndNumberExample\":{\"summary\":\"New token expiry and number\",\"value\":{\"card\":{\"brand\":\"visa\",\"country\":\"us\",\"currency\":\"usd\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"funding\":\"debit\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"lastFour\":\"4242\",\"segment\":\"consumer\"},\"createdAt\":1692972623233,\"expiry\":{\"month\":\"13\",\"year\":\"25\"},\"id\":\"network_token_eead1d640d7c\",\"merchant\":\"merchant_ddsaJsda9d86\",\"number\":\"4498004918463434\",\"paymentAccountReference\":\"512381d9f8e0629211e3949a08002\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40020248564\",\"tokenServiceProvider\":\"vts\",\"updatedAt\":1692972623768}}},\"schema\":{\"example\":{\"card\":{\"brand\":\"visa\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"lastFour\":\"4242\"},\"createdAt\":1692972623233,\"expiry\":{\"month\":\"13\",\"year\":\"25\"},\"id\":\"network_token_eead1d640d7c\",\"merchant\":\"merchant_ddsaJsda9d86\",\"number\":\"4498004918463434\",\"paymentAccountReference\":\"512381d9f8e0629211e3949a08002\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40020248564\",\"tokenServiceProvider\":\"vts\",\"updatedAt\":1692972623768},\"properties\":{\"card\":{\"description\":\"The details of the underlying encrypted card.\",\"properties\":{\"brand\":{\"description\":\"The card brand associated with the payment card.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\"],\"example\":\"visa\",\"type\":\"string\"},\"expiry\":{\"description\":\"The expiry details of the card.\",\"properties\":{\"month\":{\"description\":\"The month of the card's expiry date, in MM format (e.g. 12 for December)\",\"example\":\"12\",\"type\":\"string\"},\"year\":{\"description\":\"The year of the card's expiry date, in YY format (e.g. 26 for 2026)\",\"example\":\"23\",\"type\":\"string\"}},\"type\":\"object\"},\"lastFour\":{\"description\":\"The last four digits of the card number.\",\"example\":\"4545\",\"type\":\"string\"}},\"type\":\"object\"},\"createdAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Network Token was created.\",\"example\":1692972623233,\"format\":\"int64\",\"type\":\"integer\"},\"expiry\":{\"description\":\"The expiry details of the Network Token.\",\"properties\":{\"month\":{\"description\":\"The month of the Network Token's expiry date, in MM format (e.g. 12 for December)\",\"example\":\"12\",\"type\":\"string\"},\"year\":{\"description\":\"The year of the Network Token's expiry date, in YY format (e.g. 26 for 2026)\",\"example\":\"23\",\"type\":\"string\"}},\"type\":\"object\"},\"id\":{\"description\":\"A unique identifier representing a specific Network Token.\",\"example\":\"network_token_eead1d640d7c\",\"type\":\"string\"},\"merchant\":{\"description\":\"The unique identifier of the Merchant associated with this Network Token.\",\"example\":\"merchant_eead1d640d7c\",\"type\":\"string\"},\"number\":{\"description\":\"The unique number of the Network Token.\",\"example\":\"4545454545454545\",\"type\":\"string\"},\"paymentAccountReference\":{\"description\":\"The unique identifier of the Payment Account associated with this Network Token.\",\"example\":\"512381d9f8e0629211e3949a08002\",\"type\":\"string\"},\"status\":{\"description\":\"The status of the Network Token. Active means the token is valid and can be used for payments. Inactive means the token exists but is not currently active. Blocked and provisioning are reserved for future use. Suspended means the token is temporarily unusable but may be reactivated by the issuer or transition to deleted. Deleted is a terminal state where the token is permanently removed and a new credential must be obtained. Expired means the token has passed its expiration date and should not be used for transactions.\",\"enum\":[\"active\",\"inactive\",\"blocked\",\"provisioning\",\"suspended\",\"deleted\",\"expired\"],\"example\":\"active\",\"type\":\"string\"},\"tokenRequestorIdentifier\":{\"description\":\"The identifier of the Token Requestor (TRID) that requested the Network Token.\",\"example\":\"50165156978\",\"type\":\"string\"},\"tokenServiceProvider\":{\"description\":\"The Token Service Provider (TSP) that issued the Network Token.\",\"enum\":[\"mdes\",\"vts\",\"aets\"],\"type\":\"string\"},\"updatedAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Network Token was last updated.\",\"example\":1692972623768,\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"id\",\"number\",\"expiry\",\"card\",\"tokenRequestorIdentifier\",\"tokenServiceProvider\",\"status\",\"merchant\",\"createdAt\"],\"summary\":\"The Network Token Object\",\"type\":\"object\"}}},\"description\":\"Returns the updated Network Token object.\"}},\"security\":[{\"ApiKey\":[\"networkToken:create\"]}],\"securitySchemes\":{\"ApiKey\":{\"description\":\"Authentication using an API key. The username is the App ID and the password is the Api Key.\",\"scheme\":\"basic\",\"type\":\"http\"},\"ClientSideToken\":{\"bearerFormat\":\"Token\",\"description\":\"Authentication using a short lived token that you can share with clients. The Authorization header must be formatted as follow: \\\"Token <Client-Side Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"},\"TokenAuth\":{\"bearerFormat\":\"RunToken\",\"description\":\"Authentication using a short lived run token that you can share with clients. The Authorization header must be formatted as follow: \\\"RunToken <Function Run Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
