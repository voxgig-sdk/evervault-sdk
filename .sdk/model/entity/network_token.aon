          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          contract: {
            id: "POST /payments/network-tokens"
            json: "{\"operationId\":\"createNetworkToken\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"EvervaultEncryptedExample\":{\"value\":{\"card\":{\"cvc\":\"ev:debug:Tk9D:number:2GW8Nk96yfb2UXcw:A4UOUDGNb16Q//uBYVPibmfJ2734IrvPAoVY+8PvGG0C:5jtAu8KN1HiPeCNqSDCKMapfpg==:$\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"number\":\"ev:debug:Tk9D:number:nTepvAI585M7lUVp:AkJ6Brzat0E7ui8DSKCSXO7AopU/+GFuBekQ6cGx7eTl:sfihK53itmHp+URxomnTITUpwQwM5nnRrnQ0qdIOUlA=:$\"},\"merchant\":\"merchant_ddsaJsda9d86\"}},\"PlaintextCardExample\":{\"value\":{\"card\":{\"cvc\":\"123\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"number\":\"4242424242424242\"},\"merchant\":\"merchant_ddsaJsda9d86\"}}},\"schema\":{\"properties\":{\"card\":{\"description\":\"The card to tokenize. Either an inline card object or the unique identifier of a Card created with the [Cards API](/api#cards).\",\"oneOf\":[{\"description\":\"An inline card object.\",\"properties\":{\"cvc\":{\"description\":\"The card security code. Needs to be an Evervault-encrypted CVV or a plaintext CVV.\",\"example\":\"123\",\"type\":\"string\"},\"expiry\":{\"allOf\":[{\"properties\":{\"month\":{\"description\":\"The card expiry month, in MM format (e.g. 12 for December)\",\"example\":\"09\",\"type\":\"string\"},\"year\":{\"description\":\"The card expiry year, in YY format (e.g. 26 for 2026)\",\"example\":\"26\",\"type\":\"string\"}},\"required\":[\"month\",\"year\"],\"type\":\"object\"}],\"description\":\"The card expiry date. The expiry must be in the current month or later. Expired cards are rejected before tokenization.\"},\"number\":{\"description\":\"The card number. Needs to be an Evervault-encrypted card number or a plaintext card number.\",\"example\":\"4242424242424242\",\"type\":\"string\"}},\"required\":[\"number\",\"expiry\"],\"type\":\"object\"},{\"description\":\"The unique identifier of a Card created with the [Cards API](/api#cards).\",\"example\":\"card_eead1d640d7c\",\"type\":\"string\"}]},\"merchant\":{\"description\":\"The unique identifier of the Merchant previously created using the Evervault API. It denotes the Merchant to which the Network Token should be associated with.\",\"example\":\"merchant_ddsaJsda9d86\",\"type\":\"string\"}},\"required\":[\"card\",\"merchant\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"EvervaultEncryptedExample\":{\"summary\":\"Network Token created with encrypted card details\",\"value\":{\"card\":{\"brand\":\"visa\",\"country\":\"us\",\"currency\":\"usd\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"funding\":\"debit\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"lastFour\":\"4242\",\"segment\":\"consumer\"},\"createdAt\":1692972623233,\"expiry\":{\"month\":\"13\",\"year\":\"25\"},\"id\":\"network_token_eead1d640d7c\",\"merchant\":\"merchant_ddsaJsda9d86\",\"number\":\"4498004918463434\",\"paymentAccountReference\":\"512381d9f8e0629211e3949a08002\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40020248564\",\"tokenServiceProvider\":\"vts\",\"updatedAt\":1692972623768}},\"PlaintextCardExample\":{\"summary\":\"Network Token created with plaintext card details\",\"value\":{\"card\":{\"brand\":\"visa\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"lastFour\":\"4242\"},\"createdAt\":1692972623233,\"expiry\":{\"month\":\"13\",\"year\":\"25\"},\"id\":\"network_token_eead1d640d7c\",\"merchant\":\"merchant_ddsaJsda9d86\",\"number\":\"4498004918463434\",\"paymentAccountReference\":\"512381d9f8e0629211e3949a08002\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40020248564\",\"tokenServiceProvider\":\"vts\",\"updatedAt\":1692972623768}}},\"schema\":{\"example\":{\"card\":{\"brand\":\"visa\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"lastFour\":\"4242\"},\"createdAt\":1692972623233,\"expiry\":{\"month\":\"13\",\"year\":\"25\"},\"id\":\"network_token_eead1d640d7c\",\"merchant\":\"merchant_ddsaJsda9d86\",\"number\":\"4498004918463434\",\"paymentAccountReference\":\"512381d9f8e0629211e3949a08002\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40020248564\",\"tokenServiceProvider\":\"vts\",\"updatedAt\":1692972623768},\"properties\":{\"card\":{\"description\":\"The details of the underlying encrypted card.\",\"properties\":{\"brand\":{\"description\":\"The card brand associated with the payment card.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\"],\"example\":\"visa\",\"type\":\"string\"},\"expiry\":{\"description\":\"The expiry details of the card.\",\"properties\":{\"month\":{\"description\":\"The month of the card's expiry date, in MM format (e.g. 12 for December)\",\"example\":\"12\",\"type\":\"string\"},\"year\":{\"description\":\"The year of the card's expiry date, in YY format (e.g. 26 for 2026)\",\"example\":\"23\",\"type\":\"string\"}},\"type\":\"object\"},\"lastFour\":{\"description\":\"The last four digits of the card number.\",\"example\":\"4545\",\"type\":\"string\"}},\"type\":\"object\"},\"createdAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Network Token was created.\",\"example\":1692972623233,\"format\":\"int64\",\"type\":\"integer\"},\"expiry\":{\"description\":\"The expiry details of the Network Token.\",\"properties\":{\"month\":{\"description\":\"The month of the Network Token's expiry date, in MM format (e.g. 12 for December)\",\"example\":\"12\",\"type\":\"string\"},\"year\":{\"description\":\"The year of the Network Token's expiry date, in YY format (e.g. 26 for 2026)\",\"example\":\"23\",\"type\":\"string\"}},\"type\":\"object\"},\"id\":{\"description\":\"A unique identifier representing a specific Network Token.\",\"example\":\"network_token_eead1d640d7c\",\"type\":\"string\"},\"merchant\":{\"description\":\"The unique identifier of the Merchant associated with this Network Token.\",\"example\":\"merchant_eead1d640d7c\",\"type\":\"string\"},\"number\":{\"description\":\"The unique number of the Network Token.\",\"example\":\"4545454545454545\",\"type\":\"string\"},\"paymentAccountReference\":{\"description\":\"The unique identifier of the Payment Account associated with this Network Token.\",\"example\":\"512381d9f8e0629211e3949a08002\",\"type\":\"string\"},\"status\":{\"description\":\"The status of the Network Token. Active means the token is valid and can be used for payments. Inactive means the token exists but is not currently active. Blocked and provisioning are reserved for future use. Suspended means the token is temporarily unusable but may be reactivated by the issuer or transition to deleted. Deleted is a terminal state where the token is permanently removed and a new credential must be obtained. Expired means the token has passed its expiration date and should not be used for transactions.\",\"enum\":[\"active\",\"inactive\",\"blocked\",\"provisioning\",\"suspended\",\"deleted\",\"expired\"],\"example\":\"active\",\"type\":\"string\"},\"tokenRequestorIdentifier\":{\"description\":\"The identifier of the Token Requestor (TRID) that requested the Network Token.\",\"example\":\"50165156978\",\"type\":\"string\"},\"tokenServiceProvider\":{\"description\":\"The Token Service Provider (TSP) that issued the Network Token.\",\"enum\":[\"mdes\",\"vts\",\"aets\"],\"type\":\"string\"},\"updatedAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Network Token was last updated.\",\"example\":1692972623768,\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"id\",\"number\",\"expiry\",\"card\",\"tokenRequestorIdentifier\",\"tokenServiceProvider\",\"status\",\"merchant\",\"createdAt\"],\"summary\":\"The Network Token Object\",\"type\":\"object\"}}},\"description\":\"Returns a Network Token object.\"},\"400\":{\"content\":{\"application/json\":{\"examples\":{\"DeclinedTokenization\":{\"summary\":\"Declined Tokenization\",\"value\":{\"code\":\"payments/network-tokens/declined-tokenization\",\"detail\":\"Tokenization for the given card was declined by the card issuer. This may be due to restrictions related to the card type, issuer policies, or the card's current status\",\"title\":\"Declined Tokenization\"}},\"ExpiredCard\":{\"summary\":\"Expired Card\",\"value\":{\"code\":\"payments/network-tokens/expired-card\",\"detail\":\"The card has expired.\",\"title\":\"Expired Card\"}},\"IneligibleCard\":{\"summary\":\"Ineligible Card\",\"value\":{\"code\":\"payments/network-tokens/ineligible-card\",\"detail\":\"The card is not eligible for tokenization. This may be due to the card issuer not supporting tokenization.\",\"title\":\"Ineligible Card\"}},\"InvalidCard\":{\"summary\":\"Ineligible Card\",\"value\":{\"code\":\"payments/network-tokens/invalid-card\",\"detail\":\"The provided card details did not pass verification checks. This may be due to an invalid card number, an incorrect CVC, or a discrepancy between the provided and actual card expiry date.\",\"title\":\"Invalid Card\"}}},\"schema\":{\"properties\":{\"code\":{\"description\":\"A distinct error code, presented in slug format, that identifies a specific error.\",\"example\":\"invalid-request\",\"type\":\"string\"},\"detail\":{\"description\":\"A human-readable explanation of the error.\",\"example\":\"The provided action was invalid\",\"type\":\"string\"},\"fields\":{\"example\":[{\"pointer\":\"/card/number\",\"reason\":\"The card number is required\"}],\"items\":{\"properties\":{\"pointer\":{\"description\":\"The JSON pointer to the field that caused the error.\",\"example\":\"/card/number\",\"type\":\"string\"},\"reason\":{\"description\":\"A human-readable explanation of the error for this field.\",\"example\":\"The card number is required\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"status\":{\"description\":\"The HTTP status code for the error.\",\"example\":400,\"type\":\"integer\"},\"title\":{\"description\":\"A short, human-readable summary of the error.\",\"example\":\"Invalid Request\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"The request was invalid or cannot be otherwise served.\\n\"},\"422\":{\"content\":{\"application/json\":{\"examples\":{\"MerchantNotReady\":{\"summary\":\"Merchant Not Ready\",\"value\":{\"code\":\"payments/network-tokens/merchant-not-ready\",\"detail\":\"The merchant is not yet ready for tokenizing cards. Enrolling a merchant for network tokenization can take up to 48 hours. Please try again later.\",\"title\":\"Merchant Not Ready\"}},\"TokenServiceProviderProvisioning\":{\"summary\":\"Token Service Provider Provisioning\",\"value\":{\"code\":\"payments/network-tokens/token-service-provider-provisioning\",\"detail\":\"The Token Service Provider is currently provisioning. This may take up to 48 hours to complete. Please try again later. Contact support@evervault.com if this continues after 48 hours.\",\"title\":\"Token Service Provider Provisioning\"}}},\"schema\":{\"properties\":{\"code\":{\"description\":\"A distinct error code, presented in slug format, that identifies a specific error.\",\"example\":\"invalid-request\",\"type\":\"string\"},\"detail\":{\"description\":\"A human-readable explanation of the error.\",\"example\":\"The provided action was invalid\",\"type\":\"string\"},\"fields\":{\"example\":[{\"pointer\":\"/card/number\",\"reason\":\"The card number is required\"}],\"items\":{\"properties\":{\"pointer\":{\"description\":\"The JSON pointer to the field that caused the error.\",\"example\":\"/card/number\",\"type\":\"string\"},\"reason\":{\"description\":\"A human-readable explanation of the error for this field.\",\"example\":\"The card number is required\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"status\":{\"description\":\"The HTTP status code for the error.\",\"example\":400,\"type\":\"integer\"},\"title\":{\"description\":\"A short, human-readable summary of the error.\",\"example\":\"Invalid Request\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Unprocessable Entity\\n\"},\"500\":{\"content\":{\"application/json\":{\"examples\":{\"UnavailableTokenServiceProvider\":{\"summary\":\"Unavailable Token Service Provider\",\"value\":{\"code\":\"payments/network-tokens/unavailable-token-service-provider\",\"detail\":\"The Token Service Provider is unavailable. Please try again later.\",\"title\":\"Unavailable Token Service Provider\"}}},\"schema\":{\"properties\":{\"code\":{\"description\":\"A distinct error code, presented in slug format, that identifies a specific error.\",\"example\":\"invalid-request\",\"type\":\"string\"},\"detail\":{\"description\":\"A human-readable explanation of the error.\",\"example\":\"The provided action was invalid\",\"type\":\"string\"},\"fields\":{\"example\":[{\"pointer\":\"/card/number\",\"reason\":\"The card number is required\"}],\"items\":{\"properties\":{\"pointer\":{\"description\":\"The JSON pointer to the field that caused the error.\",\"example\":\"/card/number\",\"type\":\"string\"},\"reason\":{\"description\":\"A human-readable explanation of the error for this field.\",\"example\":\"The card number is required\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"status\":{\"description\":\"The HTTP status code for the error.\",\"example\":400,\"type\":\"integer\"},\"title\":{\"description\":\"A short, human-readable summary of the error.\",\"example\":\"Invalid Request\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"An error occurred while processing the request.\\n\"}},\"security\":[{\"ApiKey\":[\"networkToken:create\"]}],\"securitySchemes\":{\"ApiKey\":{\"description\":\"Authentication using an API key. The username is the App ID and the password is the Api Key.\",\"scheme\":\"basic\",\"type\":\"http\"},\"ClientSideToken\":{\"bearerFormat\":\"Token\",\"description\":\"Authentication using a short lived token that you can share with clients. The Authorization header must be formatted as follow: \\\"Token <Client-Side Token>\\\