scription\":\"The postal code of the address.\",\"example\":13468,\"pattern\":\"^[0-9a-zA-Z ]*$\",\"type\":\"string\"},\"state\":{\"description\":\"The state or province code. Required when `country` is `us`, `ca`, or `au`.\",\"example\":\"ny\",\"format\":\"iso-3166-2-subdivision\",\"type\":\"string\"}},\"required\":[\"line1\",\"city\",\"postalCode\",\"country\"],\"type\":\"object\"},\"legalName\":{\"description\":\"The legal name under which the Merchant's business is registered.\",\"example\":\"Acme Corp\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"}},\"type\":\"object\"},\"categoryCode\":{\"description\":\"The 4-digit Merchant Category Code (MCC).\",\"example\":\"5945\",\"type\":\"string\"},\"createdAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Merchant was created.\",\"example\":1692972623233,\"format\":\"int64\",\"type\":\"integer\"},\"id\":{\"description\":\"A unique identifier assigned to each Merchant.\",\"example\":\"merchant_eead1d640d7c\",\"type\":\"string\"},\"name\":{\"description\":\"The official name of the Merchant as recognized in transactions and communications. This name is used for display purposes and may be the company's trade name or a derived nickname.\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"},\"networkTokens\":{\"description\":\"The Merchant's Network Token configuration.\",\"properties\":{\"enrolment\":{\"description\":\"An array detailing the Merchant's enrollment status for network token issuance across different card brands.\\n\",\"items\":{\"properties\":{\"cardBrand\":{\"description\":\"The card brand (e.g., Visa, Mastercard, American Express) for which the enrollment status is being described. Currently, Network Tokens is only supported for Visa, Mastercard and American Express.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\",\"discover\",\"diners-club\",\"jcb\",\"unionpay\"],\"example\":\"visa\",\"type\":\"string\"},\"status\":{\"description\":\"The current stage of the Merchant's enrolment process for network token issuance with the specified card brand.\\n\",\"enum\":[\"active\",\"inactive\"],\"example\":\"active\",\"type\":\"string\"},\"tokenRequestorIdentifier\":{\"description\":\"The unique Token Requestor Identifier (TRID) associated with the Merchant for the specific card brand. This identifier is used when creating Network Tokens for the Merchant.\",\"example\":\"50165156978\",\"type\":[\"string\",\"null\"]}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"shortName\":{\"description\":\"A shorter version of the Merchant's name. When creating a 3D Secure session that references this Merchant by ID, `shortName` is used in place of `name` if `name` exceeds the 40-character limit imposed by the 3D Secure specification.\\n\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,40}$\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Merchant was last updated.\",\"example\":1692972623768,\"format\":\"int64\",\"type\":\"integer\"},\"website\":{\"description\":\"The official website URL of the Merchant. The domain must use a valid IANA top-level domain. See https://data.iana.org/TLD/tlds-alpha-by-domain.txt\",\"example\":\"https://www.acme.com\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"website\",\"createdAt\"],\"summary\":\"The Merchant Object\",\"type\":\"object\"},\"type\":\"array\"},\"nextPage\":{\"description\":\"The next page number to retrieve. If there are no additional Merchants, this will be `null`.\",\"type\":[\"integer\",\"null\"]},\"pageSize\":{\"description\":\"The number of Merchants retrieved per page.\",\"type\":\"integer\"},\"total\":{\"description\":\"The total count of all Merchants, after any filters.\",\"type\":\"integer\"}},\"required\":[\"data\",\"pageSize\",\"nextPage\",\"total\"],\"type\":\"object\"}}},\"description\":\"Returns a list of Merchant objects.\"}},\"security\":[{\"ApiKey\":[\"merchant:read\"]