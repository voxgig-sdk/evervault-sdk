# Entity: relay

main: kit: entity: relay: {

  alias: field: {}

  fields: [
    {
      name: "app"
      req: false
      short: "The unique identifier for the app to which the Relay belongs."
      type: "`$STRING`"
    }
    {
      name: "authentication"
      req: false
      short: "The type of authentication required for the Relay"
      type: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    {
      format: "int64"
      name: "createdAt"
      req: false
      short: "The exact time, in epoch milliseconds, when this Relay was created."
      type: "`$INTEGER`"
    }
    {
      name: "destinationDomain"
      req: false
      short: "The domain in front of which the Relay should be configured."
      type: "`$STRING`"
    }
    {
      name: "encryptEmptyStrings"
      req: false
      short: "Whether or not empty strings should be encrypted."
      type: "`$BOOLEAN`"
    }
    {
      name: "evervaultDomain"
      req: false
      short: "The Evervault managed domain to which requests to be relayed to the destination domain should be sent."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "The unique identifier for the Relay."
      type: "`$STRING`"
    }
    {
      name: "routes"
      req: false
      short: "A collection of route configurations for the Relay."
      type: "`$ARRAY`"
    }
    {
      format: "int64"
      name: "updatedAt"
      req: false
      short: "The exact time, in epoch milliseconds, when this Relay was updated."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "relay"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/relays/{id}"
          segments: [
            {
              lit: "relays"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/relays/{id}"
          segments: [
            {
              lit: "relays"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
