# Entity: card_art

main: kit: entity: card_art: {

  alias: field: {}

  fields: [
    {
      name: "data"
      req: true
      short: "The base64-encoded image data of the card art."
      type: "`$STRING`"
    }
    {
      name: "height"
      req: true
      short: "The height of the card art image in pixels."
      type: "`$INTEGER`"
    }
    {
      name: "type"
      req: true
      short: "The MIME type of the card art image."
      type: "`$STRING`"
    }
    {
      name: "width"
      req: true
      short: "The width of the card art image in pixels."
      type: "`$INTEGER`"
    }
  ]

  name: "card_art"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "network_token_id"
                orig: "network_token_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/payments/network-tokens/{network_token_id}/card-art"
          segments: [
            {
              lit: "payments"
            }
            {
              lit: "network-tokens"
            }
            {
              var: "network_token_id"
            }
            {
              lit: "card-art"
            }
          ]
          select: {
            exist: [
              "network_token_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "network_token"
      ]
    ]
  }



}
