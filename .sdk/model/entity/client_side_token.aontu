# Entity: client_side_token

main: kit: entity: client_side_token: {

  alias: field: {}

  fields: [
    {
      name: "action"
      req: true
      type: "`$STRING`"
    }
    {
      name: "expiry"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "payload"
      req: false
      type: "`$OBJECT`"
    }
  ]

  name: "client_side_token"
  op: {
