      req: false
      type: "`$INTEGER`"
    }
    {
      name: "website"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "merchant"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/payments/merchants"
          parts: [
            "payments"
            "merchants"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "merchant_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/payments/merchants/{merchant_id}"
          parts: [
            "payments"
            "merchants"
            "{id}"
          ]
          rename: {
            param: {
              merchant_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "merchant_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/payments/merchants/{merchant_id}"
          parts: [
            "payments"
            "merchants"
            "{id}"
          ]
          rename: {
            param: {
              merchant_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
