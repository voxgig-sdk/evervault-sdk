# Entity: merchant

main: kit: entity: merchant: {

  alias: field: {}

  fields: [
    {
      name: "applePay"
      req: false
      short: "The Merchant's Apple Pay configuration."
      type: "`$OBJECT`"
    }
    {
      name: "business"
      op: {
        create: {
          req: true
          type: "`$OBJECT`"
        }
      }
      req: false
      short: "The business details of the Merchant."
      type: "`$OBJECT`"
    }
    {
      name: "categoryCode"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "The 4-digit Merchant Category Code (MCC)."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "The exact time, in epoch milliseconds, when this Merchant was created."
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      short: "A unique identifier assigned to each Merchant."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The official name of the Merchant as recognized in transactions and communications."
      type: "`$STRING`"
    }
    {
      name: "networkTokens"
      req: false
      short: "The Merchant's Network Token configuration."
      type: "`$OBJECT`"
    }
    {
      name: "shortName"
      req: false
      short: "A shorter version of the Merchant's name."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: false
      short: "The exact time, in epoch milliseconds, when this Merchant was last updated."
      type: "`$INTEGER`"
    }
    {
      name: "website"
      req: true
      short: "The official website URL of the Merchant."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "merchant"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/payments/merchants"
          parts: [
            "payments"
            "merchants"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "merchant_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/payments/merchants/{merchant_id}"
          parts: [
            "payments"
            "merchants"
            "{id}"
          ]
          rename: {
            param: {
              merchant_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "merchant_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/payments/merchants/{merchant_id}"
          parts: [
            "payments"
            "merchants"
            "{id}"
          ]
          rename: {
            param: {
              merchant_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
