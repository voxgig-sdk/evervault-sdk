# Entity: merchant

main: kit: entity: merchant: {

  alias: field: {}

  fields: [
    {
      name: "applePay"
      req: false
      short: "The Merchant's Apple Pay configuration."
      type: "`$OBJECT`"
    }
    {
      name: "business"
      op: {
        create: {
          req: true
          type: "`$OBJECT`"
        }
      }
      req: false
      short: "The business details of the Merchant."
      type: "`$OBJECT`"
    }
    {
      name: "categoryCode"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "The 4-digit Merchant Category Code (MCC)."
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "createdAt"
      req: true
      short: "The exact time, in epoch milliseconds, when this Merchant was created."
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      short: "A unique identifier assigned to each Merchant."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The official name of the Merchant as recognized in transactions and communications."
      type: "`$STRING`"
    }
    {
      name: "networkTokens"
      req: false
      short: "The Merchant's Network Token configuration."
      type: "`$OBJECT`"
    }
    {
      name: "shortName"
      req: false
      short: "A shorter version of the Merchant's name."
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "updatedAt"
      req: false
      short: "The exact time, in epoch milliseconds, when this Merchant was last updated."
      type: "`$INTEGER`"
    }
    {
      name: "website"
      req: true
      short: "The official website URL of the Merchant."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "merchant"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /payments/merchants"
            json: "{\"operationId\":\"createMerchant\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"SimpleExample\":{\"value\":{\"applePay\":{\"domains\":[\"ollivanders.co.uk\"]},\"business\":{\"address\":{\"city\":\"London\",\"country\":\"gb\",\"line1\":\"Diagon Alley\",\"postalCode\":\"WD1 1AA\"},\"legalName\":\"Ollivanders Wand Shop Ltd\"},\"categoryCode\":\"5945\",\"name\":\"Ollivanders Wand Shop\",\"website\":\"https://www.ollivanders.co.uk\"}}},\"schema\":{\"properties\":{\"applePay\":{\"description\":\"The Merchant's Apple Pay configuration.\",\"properties\":{\"domains\":{\"description\":\"The domains the Merchant wants registered with Apple Pay. Only the domain name is required, without the protocol or path. For example, `example.com` is a valid domain, but `https://example.com` is not.\\n\",\"items\":{\"example\":\"ollivanders.co.uk\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"business\":{\"description\":\"The business details of the Merchant.\",\"properties\":{\"address\":{\"description\":\"The physical address of the Merchant's principal place of business.\",\"properties\":{\"city\":{\"description\":\"The city where the address is located.\",\"example\":\"Springfield\",\"pattern\":\"^[0-9a-zA-Z _\\\\-¡-￿]+$\",\"type\":\"string\"},\"country\":{\"description\":\"The country where the address is located.\",\"example\":\"us\",\"format\":\"iso-3166-1-alpha-2\",\"type\":\"string\"},\"line1\":{\"description\":\"The first line of the address.\\n\",\"example\":\"123 Main St\",\"pattern\":\"^[À-ÖØ-öø-ǿa-zA-Z0-9().\\\\-_#,;/@$!% ]+$\",\"type\":\"string\"},\"line2\":{\"description\":\"The second line of the address.\\n\",\"example\":\"Floor 4\",\"pattern\":\"^[À-ÖØ-öø-ǿa-zA-Z0-9().\\\\-_#,;/@$!% ]+$\",\"type\":\"string\"},\"postalCode\":{\"description\":\"The postal code of the address.\",\"example\":13468,\"pattern\":\"^[0-9a-zA-Z ]*$\",\"type\":\"string\"},\"state\":{\"description\":\"The state or province code. Required when `country` is `us`, `ca`, or `au`.\",\"example\":\"ny\",\"format\":\"iso-3166-2-subdivision\",\"type\":\"string\"}},\"required\":[\"line1\",\"city\",\"postalCode\",\"country\"],\"type\":\"object\"},\"legalName\":{\"description\":\"The legal name under which the Merchant's business is registered.\",\"example\":\"Acme Corp\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"}},\"required\":[\"legalName\",\"address\"],\"type\":\"object\"},\"categoryCode\":{\"description\":\"The 4-digit Merchant Category Code (MCC).\",\"example\":\"5945\",\"type\":\"string\"},\"name\":{\"description\":\"The official name of the Merchant as recognized in transactions and communications. This name is used for display purposes and may be the company's trade name or a derived nickname.\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"},\"networkTokens\":{\"description\":\"The Merchant's Network Tokens configuration. This field should only be populated if the Merchant has already been enrolled in one of the Card Network programs and can use an existing Token Requestor ID (TRID).\",\"properties\":{\"enrolment\":{\"items\":{\"properties\":{\"cardBrand\":{\"description\":\"The Card Brand for which the configuration belongs to.\",\"example\":\"mastercard\",\"type\":\"string\"},\"tokenRequestorIdentifier\":{\"description\":\"The existing Token Requestor ID assigned by the Card Brand.\",\"example\":\"50165156978\",\"type\":[\"string\",\"null\"]}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"shortName\":{\"description\":\"A shorter version of the Merchant's name. Optional. When creating a 3D Secure session that references this Merchant by ID, `shortName` is used in place of `name` if `name` exceeds the 40-character limit imposed by the 3D Secure specification.\\n\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,40}$\",\"type\":\"string\"},\"website\":{\"description\":\"The official website URL of the Merchant. The domain must use a valid IANA top-level domain. See https://data.iana.org/TLD/tlds-alpha-by-domain.txt\",\"example\":\"https://www.acme.com\",\"type\":\"string\"}},\"required\":[\"name\",\"website\",\"categoryCode\",\"business\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"SuccessfulCreation\":{\"summary\":\"Merchant successfully created\",\"value\":{\"applePay\":{\"domains\":[{\"domain\":\"ollivanders.co.uk\",\"status\":\"pending\"}]},\"business\":{\"address\":{\"city\":\"London\",\"country\":\"gb\",\"line1\":\"Diagon Alley\",\"postalCode\":\"WD1 1AA\"},\"legalName\":\"Ollivanders Wand Shop Ltd\"},\"categoryCode\":\"5945\",\"createdAt\":1692972623233,\"id\":\"merchant_eead1d640d7c\",\"name\":\"Ollivanders Wand Shop\",\"networkTokens\":{\"enrolment\":[{\"cardBrand\":\"mastercard\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"50165156978\"},{\"cardBrand\":\"visa\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40238123804\"},{\"cardBrand\":\"american-express\",\"status\":\"inactive\",\"tokenRequestorIdentifier\":null}]},\"updatedAt\":1692972623768,\"website\":\"https://www.ollivanders.co.uk\"}}},\"schema\":{\"example\":{\"applePay\":{\"domains\":[{\"domain\":\"store.ollivanders.co.uk\",\"status\":\"active\"}]},\"business\":{\"address\":{\"city\":\"London\",\"country\":\"gb\",\"line1\":\"Diagon Alley\",\"postalCode\":\"WD1 1AA\"},\"legalName\":\"Ollivanders Wand Shop Ltd\"},\"categoryCode\":\"5945\",\"createdAt\":1692972623233,\"id\":\"merchant_eead1d640d7c\",\"name\":\"Ollivanders Wand Shop\",\"networkTokens\":{\"enrolment\":[{\"cardBrand\":\"mastercard\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"50165156978\"},{\"cardBrand\":\"visa\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40238123804\"},{\"cardBrand\":\"american-express\",\"status\":\"inactive\",\"tokenRequestorIdentifier\":null}]},\"updatedAt\":1692972623768,\"website\":\"https://www.ollivanders.co.uk\"},\"properties\":{\"applePay\":{\"description\":\"The Merchant's Apple Pay configuration.\",\"properties\":{\"domains\":{\"description\":\"The domains the Merchant has enrolled with Apple Pay and the status of the enrollment.\\n\",\"items\":{\"properties\":{\"domain\":{\"description\":\"The top-level domain name of the Merchant's website.\",\"example\":\"ollivanders.co.uk\",\"type\":\"string\"},\"status\":{\"description\":\"The current status of the Merchant's Apple Pay enrollment for the\\nspecified domain. `active` means the Merchant is fully enrolled and\\ncan accept Apple Pay payments on the domain.\\n\",\"enum\":[\"active\",\"pending\",\"failed\"],\"example\":\"active\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"business\":{\"description\":\"The business details of the Merchant.\",\"properties\":{\"address\":{\"description\":\"The physical address of the Merchant's principal place of business.\",\"properties\":{\"city\":{\"description\":\"The city where the address is located.\",\"example\":\"Springfield\",\"pattern\":\"^[0-9a-zA-Z _\\\\-¡-￿]+$\",\"type\":\"string\"},\"country\":{\"description\":\"The country where the address is located.\",\"example\":\"us\",\"format\":\"iso-3166-1-alpha-2\",\"type\":\"string\"},\"line1\":{\"description\":\"The first line of the address.\\n\",\"example\":\"123 Main St\",\"pattern\":\"^[À-ÖØ-öø-ǿa-zA-Z0-9().\\\\-_#,;/@$!% ]+$\",\"type\":\"string\"},\"line2\":{\"description\":\"The second line of the address.\\n\",\"example\":\"Floor 4\",\"pattern\":\"^[À-ÖØ-öø-ǿa-zA-Z0-9().\\\\-_#,;/@$!% ]+$\",\"type\":\"string\"},\"postalCode\":{\"description\":\"The postal code of the address.\",\"example\":13468,\"pattern\":\"^[0-9a-zA-Z ]*$\",\"type\":\"string\"},\"state\":{\"description\":\"The state or province code. Required when `country` is `us`, `ca`, or `au`.\",\"example\":\"ny\",\"format\":\"iso-3166-2-subdivision\",\"type\":\"string\"}},\"required\":[\"line1\",\"city\",\"postalCode\",\"country\"],\"type\":\"object\"},\"legalName\":{\"description\":\"The legal name under which the Merchant's business is registered.\",\"example\":\"Acme Corp\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"}},\"type\":\"object\"},\"categoryCode\":{\"description\":\"The 4-digit Merchant Category Code (MCC).\",\"example\":\"5945\",\"type\":\"string\"},\"createdAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Merchant was created.\",\"example\":1692972623233,\"format\":\"int64\",\"type\":\"integer\"},\"id\":{\"description\":\"A unique identifier assigned to each Merchant.\",\"example\":\"merchant_eead1d640d7c\",\"type\":\"string\"},\"name\":{\"description\":\"The official name of the Merchant as recognized in transactions and communications. This name is used for display purposes and may be the company's trade name or a derived nickname.\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"},\"networkTokens\":{\"description\":\"The Merchant's Network Token configuration.\",\"properties\":{\"enrolment\":{\"description\":\"An array detailing the Merchant's enrollment status for network token issuance across different card brands.\\n\",\"items\":{\"properties\":{\"cardBrand\":{\"description\":\"The card brand (e.g., Visa, Mastercard, American Express) for which the enrollment status is being described. Currently, Network Tokens is only supported for Visa, Mastercard and American Express.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\",\"discover\",\"diners-club\",\"jcb\",\"unionpay\"],\"example\":\"visa\",\"type\":\"string\"},\"status\":{\"description\":\"The current stage of the Merchant's enrolment process for network token issuance with the specified card brand.\\n\",\"enum\":[\"active\",\"inactive\"],\"example\":\"active\",\"type\":\"string\"},\"tokenRequestorIdentifier\":{\"description\":\"The unique Token Requestor Identifier (TRID) associated with the Merchant for the specific card brand. This identifier is used when creating Network Tokens for the Merchant.\",\"example\":\"50165156978\",\"type\":[\"string\",\"null\"]}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"shortName\":{\"description\":\"A shorter version of the Merchant's name. When creating a 3D Secure session that references this Merchant by ID, `shortName` is used in place of `name` if `name` exceeds the 40-character limit imposed by the 3D Secure specification.\\n\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,40}$\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Merchant was last updated.\",\"example\":1692972623768,\"format\":\"int64\",\"type\":\"integer\"},\"website\":{\"description\":\"The official website URL of the Merchant. The domain must use a valid IANA top-level domain. See https://data.iana.org/TLD/tlds-alpha-by-domain.txt\",\"example\":\"https://www.acme.com\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"website\",\"createdAt\"],\"summary\":\"The Merchant Object\",\"type\":\"object\"}}},\"description\":\"Returns a Merchant object.\"}},\"security\":[{\"ApiKey\":[\"merchant:create\"]}],\"securitySchemes\":{\"ApiKey\":{\"description\":\"Authentication using an API key. The username is the App ID and the password is the Api Key.\",\"scheme\":\"basic\",\"type\":\"http\"},\"ClientSideToken\":{\"bearerFormat\":\"Token\",\"description\":\"Authentication using a short lived token that you can share with clients. The Authorization header must be formatted as follow: \\\"Token <Client-Side Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"},\"TokenAuth\":{\"bearerFormat\":\"RunToken\",\"description\":\"Authentication using a short lived run token that you can share with clients. The Authorization header must be formatted as follow: \\\"RunToken <Function Run Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/payments/merchants"
          segments: [
            {
              lit: "payments"
            }
            {
              lit: "merchants"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "merchant_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /payments/merchants/{merchant_id}"
            json: "{\"operationId\":\"getMerchant\",\"parameters\":[{\"description\":\"The unique identifier of the merchant.\",\"in\":\"path\",\"name\":\"merchant_id\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"SuccessfulCreation\":{\"summary\":\"Merchant successfully created\",\"value\":{\"applePay\":{\"domains\":[{\"domain\":\"ollivanders.co.uk\",\"status\":\"active\"}]},\"business\":{\"address\":{\"city\":\"London\",\"country\":\"gb\",\"line1\":\"Diagon Alley\",\"postalCode\":\"WD1 1AA\"},\"legalName\":\"Ollivanders Wand Shop Ltd.\"},\"categoryCode\":\"5945\",\"createdAt\":1692972623233,\"id\":\"merchant_eead1d640d7c\",\"name\":\"Ollivanders Wand Shop\",\"networkTokens\":{\"enrolment\":[{\"cardBrand\":\"mastercard\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"50165156978\"},{\"cardBrand\":\"visa\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40238123804\"},{\"cardBrand\":\"american-express\",\"status\":\"inactive\",\"tokenRequestorIdentifier\":null}]},\"updatedAt\":1692972623768,\"website\":\"https://www.ollivanders.co.uk\"}}},\"schema\":{\"example\":{\"applePay\":{\"domains\":[{\"domain\":\"store.ollivanders.co.uk\",\"status\":\"active\"}]},\"business\":{\"address\":{\"city\":\"London\",\"country\":\"gb\",\"line1\":\"Diagon Alley\",\"postalCode\":\"WD1 1AA\"},\"legalName\":\"Ollivanders Wand Shop Ltd\"},\"categoryCode\":\"5945\",\"createdAt\":1692972623233,\"id\":\"merchant_eead1d640d7c\",\"name\":\"Ollivanders Wand Shop\",\"networkTokens\":{\"enrolment\":[{\"cardBrand\":\"mastercard\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"50165156978\"},{\"cardBrand\":\"visa\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40238123804\"},{\"cardBrand\":\"american-express\",\"status\":\"inactive\",\"tokenRequestorIdentifier\":null}]},\"updatedAt\":1692972623768,\"website\":\"https://www.ollivanders.co.uk\"},\"properties\":{\"applePay\":{\"description\":\"The Merchant's Apple Pay configuration.\",\"properties\":{\"domains\":{\"description\":\"The domains the Merchant has enrolled with Apple Pay and the status of the enrollment.\\n\",\"items\":{\"properties\":{\"domain\":{\"description\":\"The top-level domain name of the Merchant's website.\",\"example\":\"ollivanders.co.uk\",\"type\":\"string\"},\"status\":{\"description\":\"The current status of the Merchant's Apple Pay enrollment for the\\nspecified domain. `active` means the Merchant is fully enrolled and\\ncan accept Apple Pay payments on the domain.\\n\",\"enum\":[\"active\",\"pending\",\"failed\"],\"example\":\"active\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"business\":{\"description\":\"The business details of the Merchant.\",\"properties\":{\"address\":{\"description\":\"The physical address of the Merchant's principal place of business.\",\"properties\":{\"city\":{\"description\":\"The city where the address is located.\",\"example\":\"Springfield\",\"pattern\":\"^[0-9a-zA-Z _\\\\-¡-￿]+$\",\"type\":\"string\"},\"country\":{\"description\":\"The country where the address is located.\",\"example\":\"us\",\"format\":\"iso-3166-1-alpha-2\",\"type\":\"string\"},\"line1\":{\"description\":\"The first line of the address.\\n\",\"example\":\"123 Main St\",\"pattern\":\"^[À-ÖØ-öø-ǿa-zA-Z0-9().\\\\-_#,;/@$!% ]+$\",\"type\":\"string\"},\"line2\":{\"description\":\"The second line of the address.\\n\",\"example\":\"Floor 4\",\"pattern\":\"^[À-ÖØ-öø-ǿa-zA-Z0-9().\\\\-_#,;/@$!% ]+$\",\"type\":\"string\"},\"postalCode\":{\"description\":\"The postal code of the address.\",\"example\":13468,\"pattern\":\"^[0-9a-zA-Z ]*$\",\"type\":\"string\"},\"state\":{\"description\":\"The state or province code. Required when `country` is `us`, `ca`, or `au`.\",\"example\":\"ny\",\"format\":\"iso-3166-2-subdivision\",\"type\":\"string\"}},\"required\":[\"line1\",\"city\",\"postalCode\",\"country\"],\"type\":\"object\"},\"legalName\":{\"description\":\"The legal name under which the Merchant's business is registered.\",\"example\":\"Acme Corp\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"}},\"type\":\"object\"},\"categoryCode\":{\"description\":\"The 4-digit Merchant Category Code (MCC).\",\"example\":\"5945\",\"type\":\"string\"},\"createdAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Merchant was created.\",\"example\":1692972623233,\"format\":\"int64\",\"type\":\"integer\"},\"id\":{\"description\":\"A unique identifier assigned to each Merchant.\",\"example\":\"merchant_eead1d640d7c\",\"type\":\"string\"},\"name\":{\"description\":\"The official name of the Merchant as recognized in transactions and communications. This name is used for display purposes and may be the company's trade name or a derived nickname.\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"},\"networkTokens\":{\"description\":\"The Merchant's Network Token configuration.\",\"properties\":{\"enrolment\":{\"description\":\"An array detailing the Merchant's enrollment status for network token issuance across different card brands.\\n\",\"items\":{\"properties\":{\"cardBrand\":{\"description\":\"The card brand (e.g., Visa, Mastercard, American Express) for which the enrollment status is being described. Currently, Network Tokens is only supported for Visa, Mastercard and American Express.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\",\"discover\",\"diners-club\",\"jcb\",\"unionpay\"],\"example\":\"visa\",\"type\":\"string\"},\"status\":{\"description\":\"The current stage of the Merchant's enrolment process for network token issuance with the specified card brand.\\n\",\"enum\":[\"active\",\"inactive\"],\"example\":\"active\",\"type\":\"string\"},\"tokenRequestorIdentifier\":{\"description\":\"The unique Token Requestor Identifier (TRID) associated with the Merchant for the specific card brand. This identifier is used when creating Network Tokens for the Merchant.\",\"example\":\"50165156978\",\"type\":[\"string\",\"null\"]}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"shortName\":{\"description\":\"A shorter version of the Merchant's name. When creating a 3D Secure session that references this Merchant by ID, `shortName` is used in place of `name` if `name` exceeds the 40-character limit imposed by the 3D Secure specification.\\n\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,40}$\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Merchant was last updated.\",\"example\":1692972623768,\"format\":\"int64\",\"type\":\"integer\"},\"website\":{\"description\":\"The official website URL of the Merchant. The domain must use a valid IANA top-level domain. See https://data.iana.org/TLD/tlds-alpha-by-domain.txt\",\"example\":\"https://www.acme.com\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"website\",\"createdAt\"],\"summary\":\"The Merchant Object\",\"type\":\"object\"}}},\"description\":\"Returns a Merchant object.\"}},\"security\":[{\"ApiKey\":[\"merchant:read\"]}],\"securitySchemes\":{\"ApiKey\":{\"description\":\"Authentication using an API key. The username is the App ID and the password is the Api Key.\",\"scheme\":\"basic\",\"type\":\"http\"},\"ClientSideToken\":{\"bearerFormat\":\"Token\",\"description\":\"Authentication using a short lived token that you can share with clients. The Authorization header must be formatted as follow: \\\"Token <Client-Side Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"},\"TokenAuth\":{\"bearerFormat\":\"RunToken\",\"description\":\"Authentication using a short lived run token that you can share with clients. The Authorization header must be formatted as follow: \\\"RunToken <Function Run Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/payments/merchants/{merchant_id}"
          rename: {
            param: {
              merchant_id: "id"
            }
          }
          segments: [
            {
              lit: "payments"
            }
            {
              lit: "merchants"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "merchant_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "PATCH /payments/merchants/{merchant_id}"
            json: "{\"operationId\":\"updateMerchant\",\"parameters\":[{\"description\":\"The id of the Merchant to be updated.\",\"in\":\"path\",\"name\":\"merchant_id\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"SimpleExample\":{\"value\":{\"applePay\":{\"domains\":[\"ollivanders.co.uk\"]},\"shortName\":\"Ollivanders\"}}},\"schema\":{\"properties\":{\"applePay\":{\"description\":\"The Merchant's Apple Pay configuration.\",\"properties\":{\"domains\":{\"description\":\"The domains the Merchant wants registered with Apple Pay. To remove a domain previously registered with Apple Pay, exclude it from the list. Only the domain name is required, without the protocol or path. For example, `example.com` is a valid domain, but `https://example.com` is not.\\n\",\"items\":{\"example\":\"ollivanders.co.uk\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"shortName\":{\"description\":\"A shorter version of the Merchant's name. When creating a 3D Secure session that references this Merchant by ID, `shortName` is used in place of `name` if `name` exceeds the 40-character limit imposed by the 3D Secure specification.\\n\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,40}$\",\"type\":\"string\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"SuccessfulCreation\":{\"summary\":\"Merchant successfully updated\",\"value\":{\"applePay\":{\"domains\":[{\"domain\":\"ollivanders.co.uk\",\"status\":\"pending\"}]},\"business\":{\"address\":{\"city\":\"London\",\"country\":\"gb\",\"line1\":\"Diagon Alley\",\"postalCode\":\"WD1 1AA\"},\"legalName\":\"Ollivanders Wand Shop Ltd.\"},\"categoryCode\":\"5945\",\"createdAt\":1692972623233,\"id\":\"merchant_eead1d640d7c\",\"name\":\"Ollivanders Wand Shop\",\"networkTokens\":{\"enrolment\":[{\"cardBrand\":\"mastercard\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"50165156978\"},{\"cardBrand\":\"visa\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"402338123804\"},{\"cardBrand\":\"american-express\",\"status\":\"inactive\",\"tokenRequestorIdentifier\":null}]},\"shortName\":\"Ollivanders\",\"updatedAt\":1692972623768,\"website\":\"https://www.ollivanders.co.uk\"}}},\"schema\":{\"example\":{\"applePay\":{\"domains\":[{\"domain\":\"store.ollivanders.co.uk\",\"status\":\"active\"}]},\"business\":{\"address\":{\"city\":\"London\",\"country\":\"gb\",\"line1\":\"Diagon Alley\",\"postalCode\":\"WD1 1AA\"},\"legalName\":\"Ollivanders Wand Shop Ltd\"},\"categoryCode\":\"5945\",\"createdAt\":1692972623233,\"id\":\"merchant_eead1d640d7c\",\"name\":\"Ollivanders Wand Shop\",\"networkTokens\":{\"enrolment\":[{\"cardBrand\":\"mastercard\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"50165156978\"},{\"cardBrand\":\"visa\",\"status\":\"active\",\"tokenRequestorIdentifier\":\"40238123804\"},{\"cardBrand\":\"american-express\",\"status\":\"inactive\",\"tokenRequestorIdentifier\":null}]},\"updatedAt\":1692972623768,\"website\":\"https://www.ollivanders.co.uk\"},\"properties\":{\"applePay\":{\"description\":\"The Merchant's Apple Pay configuration.\",\"properties\":{\"domains\":{\"description\":\"The domains the Merchant has enrolled with Apple Pay and the status of the enrollment.\\n\",\"items\":{\"properties\":{\"domain\":{\"description\":\"The top-level domain name of the Merchant's website.\",\"example\":\"ollivanders.co.uk\",\"type\":\"string\"},\"status\":{\"description\":\"The current status of the Merchant's Apple Pay enrollment for the\\nspecified domain. `active` means the Merchant is fully enrolled and\\ncan accept Apple Pay payments on the domain.\\n\",\"enum\":[\"active\",\"pending\",\"failed\"],\"example\":\"active\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"business\":{\"description\":\"The business details of the Merchant.\",\"properties\":{\"address\":{\"description\":\"The physical address of the Merchant's principal place of business.\",\"properties\":{\"city\":{\"description\":\"The city where the address is located.\",\"example\":\"Springfield\",\"pattern\":\"^[0-9a-zA-Z _\\\\-¡-￿]+$\",\"type\":\"string\"},\"country\":{\"description\":\"The country where the address is located.\",\"example\":\"us\",\"format\":\"iso-3166-1-alpha-2\",\"type\":\"string\"},\"line1\":{\"description\":\"The first line of the address.\\n\",\"example\":\"123 Main St\",\"pattern\":\"^[À-ÖØ-öø-ǿa-zA-Z0-9().\\\\-_#,;/@$!% ]+$\",\"type\":\"string\"},\"line2\":{\"description\":\"The second line of the address.\\n\",\"example\":\"Floor 4\",\"pattern\":\"^[À-ÖØ-öø-ǿa-zA-Z0-9().\\\\-_#,;/@$!% ]+$\",\"type\":\"string\"},\"postalCode\":{\"description\":\"The postal code of the address.\",\"example\":13468,\"pattern\":\"^[0-9a-zA-Z ]*$\",\"type\":\"string\"},\"state\":{\"description\":\"The state or province code. Required when `country` is `us`, `ca`, or `au`.\",\"example\":\"ny\",\"format\":\"iso-3166-2-subdivision\",\"type\":\"string\"}},\"required\":[\"line1\",\"city\",\"postalCode\",\"country\"],\"type\":\"object\"},\"legalName\":{\"description\":\"The legal name under which the Merchant's business is registered.\",\"example\":\"Acme Corp\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"}},\"type\":\"object\"},\"categoryCode\":{\"description\":\"The 4-digit Merchant Category Code (MCC).\",\"example\":\"5945\",\"type\":\"string\"},\"createdAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Merchant was created.\",\"example\":1692972623233,\"format\":\"int64\",\"type\":\"integer\"},\"id\":{\"description\":\"A unique identifier assigned to each Merchant.\",\"example\":\"merchant_eead1d640d7c\",\"type\":\"string\"},\"name\":{\"description\":\"The official name of the Merchant as recognized in transactions and communications. This name is used for display purposes and may be the company's trade name or a derived nickname.\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,60}$\",\"type\":\"string\"},\"networkTokens\":{\"description\":\"The Merchant's Network Token configuration.\",\"properties\":{\"enrolment\":{\"description\":\"An array detailing the Merchant's enrollment status for network token issuance across different card brands.\\n\",\"items\":{\"properties\":{\"cardBrand\":{\"description\":\"The card brand (e.g., Visa, Mastercard, American Express) for which the enrollment status is being described. Currently, Network Tokens is only supported for Visa, Mastercard and American Express.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\",\"discover\",\"diners-club\",\"jcb\",\"unionpay\"],\"example\":\"visa\",\"type\":\"string\"},\"status\":{\"description\":\"The current stage of the Merchant's enrolment process for network token issuance with the specified card brand.\\n\",\"enum\":[\"active\",\"inactive\"],\"example\":\"active\",\"type\":\"string\"},\"tokenRequestorIdentifier\":{\"description\":\"The unique Token Requestor Identifier (TRID) associated with the Merchant for the specific card brand. This identifier is used when creating Network Tokens for the Merchant.\",\"example\":\"50165156978\",\"type\":[\"string\",\"null\"]}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"shortName\":{\"description\":\"A shorter version of the Merchant's name. When creating a 3D Secure session that references this Merchant by ID, `shortName` is used in place of `name` if `name` exceeds the 40-character limit imposed by the 3D Secure specification.\\n\",\"example\":\"Acme\",\"pattern\":\"^[a-zA-Z0-9 ]{1,40}$\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"The exact time, in epoch milliseconds, when this Merchant was last updated.\",\"example\":1692972623768,\"format\":\"int64\",\"type\":\"integer\"},\"website\":{\"description\":\"The official website URL of the Merchant. The domain must use a valid IANA top-level domain. See https://data.iana.org/TLD/tlds-alpha-by-domain.txt\",\"example\":\"https://www.acme.com\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"website\",\"createdAt\"],\"summary\":\"The Merchant Object\",\"type\":\"object\"}}},\"description\":\"Returns the updated Merchant object.\"}},\"security\":[{\"ApiKey\":[\"merchant:update\"]}],\"securitySchemes\":{\"ApiKey\":{\"description\":\"Authentication using an API key. The username is the App ID and the password is the Api Key.\",\"scheme\":\"basic\",\"type\":\"http\"},\"ClientSideToken\":{\"bearerFormat\":\"Token\",\"description\":\"Authentication using a short lived token that you can share with clients. The Authorization header must be formatted as follow: \\\"Token <Client-Side Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"},\"TokenAuth\":{\"bearerFormat\":\"RunToken\",\"description\":\"Authentication using a short lived run token that you can share with clients. The Authorization header must be formatted as follow: \\\"RunToken <Function Run Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
