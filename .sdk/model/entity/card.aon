            json: "{\"operationId\":\"registerCard\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"EvervaultEncryptedExample\":{\"value\":{\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"number\":\"ev:debug:Tk9D:number:nTepvAI585M7lUVp:AkJ6Brzat0E7ui8DSKCSXO7AopU/+GFuBekQ6cGx7eTl:sfihK53itmHp+URxomnTITUpwQwM5nnRrnQ0qdIOUlA=:$\"}},\"PlaintextCardExample\":{\"value\":{\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"number\":\"4242424242424242\"}}},\"schema\":{\"properties\":{\"expiry\":{\"properties\":{\"month\":{\"description\":\"The card expiry month, in MM format (e.g. 12 for December)\",\"example\":\"09\",\"type\":\"string\"},\"year\":{\"description\":\"The card expiry year, in YY format (e.g. 26 for 2026)\",\"example\":\"26\",\"type\":\"string\"}},\"required\":[\"month\",\"year\"],\"type\":\"object\"},\"number\":{\"description\":\"The card number. This should be a valid Evervault encrypted card number or a valid plaintext card number.\",\"example\":\"4242424242424242\",\"type\":\"string\"}},\"required\":[\"number\",\"expiry\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"SuccessfulCreation\":{\"summary\":\"Card successfully created\",\"value\":{\"automaticUpdates\":\"enabled\",\"bin\":\"424242\",\"brand\":\"visa\",\"country\":\"gb\",\"createdAt\":169297262323,\"currency\":\"gbp\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"funding\":\"credit\",\"id\":\"card_eead1d640d7c\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"lastFour\":\"4242\",\"number\":\"ev:debug:Tk9D:number:nTepvAI585M7lUVp:AkJ6Brzat0E7ui8DSKCSXO7AopU/+GFuBekQ6cGx7eTl:sfihK53itmHp+URxomnTITUpwQwM5nnRrnQ0qdIOUlA=:$\",\"replacement\":null,\"segment\":\"consumer\",\"status\":\"active\",\"updatedAt\":null}}},\"schema\":{\"example\":{\"automaticUpdates\":\"enabled\",\"bin\":\"424242\",\"brand\":\"visa\",\"country\":\"gb\",\"createdAt\":169297262323,\"currency\":\"gbp\",\"expiry\":{\"month\":\"9\",\"year\":\"26\"},\"funding\":\"credit\",\"id\":\"card_eead1d640d7c\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"lastFour\":\"4242\",\"number\":\"ev:debug:Tk9D:number:nTepvAI585M7lUVp:AkJ6Brzat0E7ui8DSKCSXO7AopU/+GFuBekQ6cGx7eTl:sfihK53itmHp+URxomnTITUpwQwM5nnRrnQ0qdIOUlA=:$\",\"replacement\":null,\"segment\":\"consumer\",\"status\":\"active\",\"updatedAt\":null},\"properties\":{\"automaticUpdates\":{\"description\":\"The status of Card Account Updater on this card. Evervault currently supports Card Account Updates for Visa, Mastercard and American Express cards.\\n\",\"enum\":[\"enabled\",\"issuer-not-enrolled\",\"disabled\"],\"type\":\"string\"},\"bin\":{\"description\":\"The first 6 or 8 digits of the card number.\",\"example\":\"424242\",\"type\":\"string\"},\"brand\":{\"description\":\"The card brand associated with the payment card.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\",\"discover\",\"diners-club\",\"jcb\",\"unionpay\"],\"example\":\"visa\",\"type\":\"string\"},\"country\":{\"description\":\"The country where the card was issued.\",\"example\":\"gb\",\"format\":\"iso-3166-1-alpha-2\",\"type\":\"string\"},\"createdAt\":{\"description\":\"The Unix timestamp of when the card was created.\",\"example\":1692972623233,\"type\":\"integer\"},\"currency\":{\"description\":\"The currency of the card.\",\"example\":\"gbp\",\"format\":\"iso-4217-alphabetic\",\"type\":\"string\"},\"expiry\":{\"description\":\"The expiry date of the card.\",\"properties\":{\"month\":{\"description\":\"The card expiry month, in MM format (e.g. 12 for December)\",\"example\":\"09\",\"type\":\"string\"},\"year\":{\"description\":\"The card expiry year, in YY format (e.g. 26 for 2026)\",\"example\":\"26\",\"type\":\"string\"}},\"required\":[\"month\",\"year\"],\"type\":\"object\"},\"funding\":{\"description\":\"The card funding type specifies the method by which transactions are\\nfinanced.\\n\",\"enum\":[\"debit\",\"credit\",\"prepaid\",\"deferred-debit\",\"charge\"],\"example\":\"debit\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier for the card.\",\"example\":\"card_eead1d640d7c\",\"type\":\"string\"},\"issuer\":{\"description\":\"The name of the card issuer.\",\"example\":\"Gringotts Wizarding Bank and Trust Company\",\"type\":\"string\"},\"lastFour\":{\"description\":\"The last 4 digits of the card number.\",\"example\":\"4242\",\"type\":\"string\"},\"number\":{\"description\":\"The Evervault encrypted card number. This can be decrypted using Relay decryption or using a function.\",\"example\":\"ev:\",\"type\":\"string\"},\"replacement\":{\"description\":\"The ID of the replacement card. This field is only present if the card has been replaced.\",\"example\":\"card_eead1d640d7c\",\"type\":[\"string\",\"null\"]},\"segment\":{\"description\":\"The card segment indicates the primary market or usage category of the\\ncard.\\n\",\"enum\":[\"consumer\",\"commercial\",\"business\",\"government\",\"payouts\",\"all\"],\"example\":\"consumer\",\"type\":\"string\"},\"status\":{\"description\":\"The current status of the card.\",\"enum\":[\"active\",\"replaced\",\"closed\",\"invalid\"],\"example\":\"active\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"The Unix timestamp of when the card was last updated.\",\"example\":1692972623768,\"type\":[\"integer\",\"null\"]}},\"required\":[\"number\",\"bin\",\"lastFour\",\"createdAt\"],\"summary\":\"The Card Object\",\"type\":\"object\"}}},\"description\":\"Returns an existing Card object. If the card number is already registered but with a different expiry date, the date is updated to the value in the request before the Card object is returned.\"},\"201\":{\"content\":{\"application/json\":{\"examples\":{\"SuccessfulCreation\":{\"summary\":\"Card successfully created\",\"value\":{\"automaticUpdates\":\"enabled\",\"bin\":\"424242\",\"brand\":\"visa\",\"country\":\"gb\",\"createdAt\":169297262323,\"currency\":\"gbp\