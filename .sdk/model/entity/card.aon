          }
          contract: {
            id: "POST /payments/cards/{card_id}/simulate"
            json: "{\"operationId\":\"simulateCardUpdate\",\"parameters\":[{\"description\":\"The id of the Card\",\"in\":\"path\",\"name\":\"card_id\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"AccountClosureExample\":{\"value\":{\"updateType\":\"account-closure\"}},\"NewAccountNumberExample\":{\"value\":{\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"number\":\"4242424242424242\",\"updateType\":\"new-account-number\"}},\"NewExpiryDateExample\":{\"value\":{\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"updateType\":\"new-expiry-date\"}}},\"schema\":{\"description\":\"The request body for simulating a card update differs depending on the type of event you want to simulate.\",\"oneOf\":[{\"description\":\"New account number\",\"properties\":{\"expiry\":{\"properties\":{\"month\":{\"description\":\"The card expiry month, in MM format (e.g. 12 for December)\",\"example\":\"09\",\"type\":\"string\"},\"year\":{\"description\":\"The card expiry year, in YY format (e.g. 26 for 2026)\",\"example\":\"26\",\"type\":\"string\"}},\"required\":[\"month\",\"year\"],\"type\":\"object\"},\"number\":{\"description\":\"The card number. Can be clear-text or an Evervault encrypted string.\",\"example\":\"4242424242424242\",\"type\":\"string\"},\"updateType\":{\"description\":\"The type of update to simulate.\",\"enum\":[\"new-account-number\"],\"type\":\"string\"}},\"required\":[\"updateType\"],\"type\":\"object\"},{\"description\":\"New expiry date\",\"properties\":{\"expiry\":{\"properties\":{\"month\":{\"description\":\"The card expiry month, in MM format (e.g. 12 for December)\",\"example\":\"09\",\"type\":\"string\"},\"year\":{\"description\":\"The card expiry year, in YY format (e.g. 26 for 2026)\",\"example\":\"26\",\"type\":\"string\"}},\"required\":[\"month\",\"year\"],\"type\":\"object\"},\"updateType\":{\"description\":\"The type of update to simulate.\",\"enum\":[\"new-expiry-date\"],\"type\":\"string\"}},\"required\":[\"updateType\"],\"type\":\"object\"},{\"description\":\"Account closure\",\"properties\":{\"updateType\":{\"description\":\"The type of update to simulate.\",\"enum\":[\"account-closure\"],\"type\":\"string\"}},\"required\":[\"updateType\"],\"type\":\"object\"}],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"AccountClosureExample\":{\"summary\":\"Account closure\",\"value\":{\"automaticUpdates\":\"enabled\",\"bin\":\"424242\",\"brand\":\"visa\",\"country\":\"gb\",\"createdAt\":169297262323,\"currency\":\"gbp\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"funding\":\"credit\",\"id\":\"card_eead1d640d7c\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"lastFour\":\"4242\",\"number\":\"ev:debug:Tk9D:number:nTepvAI585M7lUVp:AkJ6Brzat0E7ui8DSKCSXO7AopU/+GFuBekQ6cGx7eTl:sfihK53itmHp+URxomnTITUpwQwM5nnRrnQ0qdIOUlA=:$\",\"replacement\":null,\"segment\":\"consumer\",\"status\":\"closed\",\"updatedAt\":169297262376}},\"NewAccountNumberExample\":{\"summary\":\"New account number\",\"value\":{\"automaticUpdates\":\"enabled\",\"bin\":\"424242\",\"brand\":\"visa\",\"country\":\"gb\",\"createdAt\":169297262323,\"currency\":\"gbp\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"funding\":\"credit\",\"id\":\"card_eead1d640d7c\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"lastFour\":\"4242\",\"number\":\"ev:debug:Tk9D:number:nTepvAI585M7lUVp:AkJ6Brzat0E7ui8DSKCSXO7AopU/+GFuBekQ6cGx7eTl:sfihK53itmHp+URxomnTITUpwQwM5nnRrnQ0qdIOUlA=:$\",\"replacement\":\"card_eead1d640d7c\",\"segment\":\"consumer\",\"status\":\"replaced\",\"updatedAt\":169297262376}},\"NewExpiryDateExample\":{\"summary\":\"New expiry date\",\"value\":{\"automaticUpdates\":\"enabled\",\"bin\":\"424242\",\"brand\":\"visa\",\"country\":\"gb\",\"createdAt\":169297262323,\"currency\":\"gbp\",\"expiry\":{\"month\":\"09\",\"year\":\"26\"},\"funding\":\"credit\",\"id\":\"card_eead1d640d7c\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"lastFour\":\"4242\",\"number\":\"ev:debug:Tk9D:number:nTepvAI585M7lUVp:AkJ6Brzat0E7ui8DSKCSXO7AopU/+GFuBekQ6cGx7eTl:sfihK53itmHp+URxomnTITUpwQwM5nnRrnQ0qdIOUlA=:$\",\"replacement\":\"card_eead1d640d7c\",\"segment\":\"consumer\",\"status\":\"replaced\",\"updatedAt\":169297262376}}},\"schema\":{\"example\":{\"automaticUpdates\":\"enabled\",\"bin\":\"424242\",\"brand\":\"visa\",\"country\":\"gb\",\"createdAt\":169297262323,\"currency\":\"gbp\",\"expiry\":{\"month\":\"9\",\"year\":\"26\"},\"funding\":\"credit\",\"id\":\"card_eead1d640d7c\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"lastFour\":\"4242\",\"number\":\"ev:debug:Tk9D:number:nTepvAI585M7lUVp:AkJ6Brzat0E7ui8DSKCSXO7AopU/+GFuBekQ6cGx7eTl:sfihK53itmHp+URxomnTITUpwQwM5nnRrnQ0qdIOUlA=:$\",\"replacement\":null,\"segment\":\"consumer\",\"status\":\"active\",\"updatedAt\":null},\"properties\":{\"automaticUpdates\":{\"description\":\"The status of Card Account Updater on this card. Evervault currently supports Card Account Updates for Visa, Mastercard and American Express cards.\\n\",\"enum\":[\"enabled\",\"issuer-not-enrolled\",\"disabled\"],\"type\":\"string\"},\"bin\":{\"description\":\"The first 6 or 8 digits of the card number.\",\"example\":\"424242\",\"type\":\"string\"},\"brand\":{\"description\":\"The card brand associated with the payment card.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\",\"discover\",\"diners-club\",\"jcb\",\"unionpay\"],\"example\":\"visa\",\"type\":\"string\"},\"country\":{\"description\":\"The country where the card was issued.\",\"example\":\"gb\",\"format\":\"iso-3166-1-alpha-2\",\"type\":\"string\"},\"createdAt\":{\"description\":\"The Unix timestamp of when the card was created.\",\"example\":1692972623233,\"type\":\"integer\"},\"currency\":{\"description\":\"The currency of the card.\",\"example\":\"gbp\",\"format\":\"iso-4217-alphabetic\",\"type\":\"string\"},\"expiry\":{\"description\":\"The expiry date of the card.\",\"properties\":{\"month\":{\"description\":\"The card expiry month, in MM format (e.g. 12 for December)\",\"example\":\"09\",\"type\":\"string\"},\"year\":{\"description\":\"The card expiry year, in YY format (e.g. 26 for 2026)\",\"example\":\"26\",\"type\":\"string\"}},\"required\":[\"month\",\"year\"],\"type\":\"object\"},\"funding\":{\"description\":\"The card funding type specifies the method by which transactions are\\nfinanced.\\n\",\"enum\":[\"debit\",\"credit\",\"prepaid\",\"deferred-debit\",\"charge\"],\"example\":\"debit\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier for the card.\",\"example\":\"card_eead1d640d7c\",\"type\":\"string\"},\"issuer\":{\"description\":\"The name of the card issuer.\",\"example\":\"Gringotts Wizarding Bank and Trust Company\",\"type\":\"string\"},\"lastFour\":{\"description\":\"The last 4 digits of the card number.\",\"example\":\"4242\",\"type\":\"string\"},\"number\":{\"description\":\"The Evervault encrypted card number. This can be decrypted using Relay decryption or using a function.\",\"example\":\"ev:\",\"type\":\"string\"},\"replacement\":{\"description\":\"The ID of the replacement card. This field is only present if the card has been replaced.\",\"example\":\"card_eead1d640d7c\",\"type\":[\"string\",\"null\"]},\"segment\":{\"description\":\"The card segment indicates the primary market or usage category of the\\ncard.\\n\",\"enum\":[\"consumer\",\"commercial\",\"business\",\"government\",\"payouts\",\"all\"],\"example\":\"consumer\",\"type\":\"string\"},\"status\":{\"description\":\"The current status of the card.\",\"enum\":[\"active\",\"replaced\",\"closed\",\"invalid\"],\"example\":\"active\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"The Unix timestamp of when the card was last updated.\",\"example\":1692972623768,\"type\":[\"integer\",\"null\"]}},\"required\":[\"number\",\"bin\",\"lastFour\",\"createdAt\"],\"summary\":\"The Card Object\",\"type\":\"object\"}}},\"description\":\"Returns the updated Card object.\"}},\"security\":[{\"ApiKey\":[\"card:create\"]}],\"securitySchemes\":{\"ApiKey\":{\"description\":\"Authentication using an API key. The username is the App ID and the password is the Api Key.\",\"scheme\":\"basic\",\"type\":\"http\"},\"ClientSideToken\":{\"bearerFormat\":\"Token\",\"description\":\"Authentication using a short lived token that you can share with clients. The Authorization header must be formatted as follow: \\\"Token <Client-Side Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"},\"TokenAuth\":{\"bearerFormat\":\"RunToken\",\"description\":\"Authentication using a short lived run token that you can share with clients. The Authorization header must be formatted as follow: \\\"RunToken <Function Run Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/payments/cards/{card_id}/simulate"
          rename: {
            param: {
              card_id: "id"
            }
          }
          segments: [
            {
              lit: "payments"
            }
            {
              lit: "cards"
            }
            {
              var: "id"
            }
            {
              lit: "simulate"
            }
          ]
          select: {
            "$action": "simulate"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.expiry`"
          }
        }
        {
          contract: {
            id: "POST /insights/cards"
            json: "{\"operationId\":\"createCardInsight\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"SimpleExample\":{\"value\":{\"address\":{\"city\":\"New York\",\"country\":\"us\",\"line1\":\"123 Main Street\",\"line2\":\"Apt 4B\",\"postalCode\":\"10001\",\"state\":\"ny\"},\"card\":{\"cvv\":\"123\",\"expiry\":{\"month\":\"09\",\"year\":\"29\"},\"number\":\"4111111111111111\"},\"cardholder\":{\"firstName\":\"John\",\"lastName\":\"Doe\"},\"extensions\":[\"capabilities\",\"cvv\",\"address\",\"cardholder\"]}}},\"schema\":{\"properties\":{\"address\":{\"description\":\"Details about the cardholder's address that the address verification (AVS) is for. Required if the `address` extension is requested.\",\"properties\":{\"city\":{\"description\":\"The city name\",\"example\":\"New York\",\"type\":\"string\"},\"country\":{\"description\":\"The country code.\",\"example\":\"us\",\"format\":\"iso-3166-1-alpha-2\",\"type\":\"string\"},\"line1\":{\"description\":\"Street address line 1\",\"example\":\"123 Main Street\",\"type\":\"string\"},\"line2\":{\"description\":\"Street address line 2\",\"example\":\"Apt 4B\",\"type\":\"string\"},\"postalCode\":{\"description\":\"The ZIP or postal code.\",\"example\":\"10001\",\"type\":\"string\"},\"state\":{\"description\":\"The state or province code. Required when `country` is `us`, `ca`, or `au`.\",\"example\":\"ny\",\"format\":\"iso-3166-2-subdivision\",\"type\":\"string\"}},\"required\":[\"postalCode\"],\"type\":\"object\"},\"card\":{\"description\":\"The card details.\",\"properties\":{\"cvv\":{\"description\":\"The card security code. This should be a valid Evervault encrypted CVV or a valid plaintext CVV. Required if the `cvv` extension is requested.\",\"example\":\"123\",\"type\":\"string\"},\"expiry\":{\"description\":\"The card expiry. Required if the `address`, `cardholder`, or `cvv` extensions are requested.\",\"properties\":{\"month\":{\"description\":\"The card expiry month\",\"example\":\"12\",\"type\":\"string\"},\"year\":{\"description\":\"The card expiry year\",\"example\":\"29\",\"type\":\"string\"}},\"type\":\"object\"},\"number\":{\"description\":\"The card number. This should be a valid Evervault encrypted card number or a valid plaintext card number.\",\"example\":\"4111111111111111\",\"type\":\"string\"}},\"required\":[\"number\"],\"type\":\"object\"},\"cardholder\":{\"description\":\"Details about the cardholder that the name verification (ANI) is for. Required if the `cardholder` extension is requested.\",\"properties\":{\"firstName\":{\"description\":\"The first name of the cardholder\",\"example\":\"John\",\"type\":\"string\"},\"lastName\":{\"description\":\"The last name of the cardholder\",\"example\":\"Doe\",\"type\":\"string\"}},\"type\":\"object\"},\"extensions\":{\"description\":\"The extensions to the card insight request.\",\"items\":{\"description\":\"The extensions\",\"enum\":[\"capabilities\",\"cvv\",\"cardholder\",\"address\"],\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"card\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"Success\":{\"summary\":\"Successful Card Insight createFunctionRun\",\"value\":{\"address\":{\"avsIdentifier\":\"aBcdeFGhIJKlmnoPqR\",\"networkIdentifier\":\"1234567890\",\"networkResponseCode\":{\"value\":\"85\"},\"result\":{\"address\":\"match\",\"value\":\"Y\",\"zip\":\"match\"}},\"bin\":{\"brand\":\"visa\",\"country\":\"us\",\"currency\":\"usd\",\"fastFunds\":{\"crossBorder\":true,\"domestic\":true},\"funding\":\"credit\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"productName\":\"Visa Credit\",\"segment\":\"consumer\",\"threeDS\":{\"acsInfoIndicators\":[{\"code\":\"acs-auth-available\",\"description\":\"Authentication Available at ACS\",\"indicator\":\"01\"}],\"supportedVersions\":{\"accessControlServer\":[\"2.2.0\"],\"directoryServer\":[\"2.2.0\",\"2.3.1\"]}},\"type\":\"card\"},\"capabilities\":{\"pull\":{\"country\":{\"alphaCode\":\"us\",\"numericCode\":\"840\"},\"currency\":{\"alphaCode\":\"usd\",\"numericCode\":\"840\"},\"enabled\":true,\"network\":\"visa\",\"regulated\":true,\"type\":\"credit\"},\"push\":{\"availability\":\"immediate\",\"country\":{\"alphaCode\":\"us\",\"numericCode\":\"840\"},\"currency\":{\"alphaCode\":\"usd\",\"numericCode\":\"840\"},\"enabled\":true,\"network\":\"visa\",\"regulated\":true,\"type\":\"credit\"}},\"cardholder\":{\"firstName\":{\"code\":\"match\",\"value\":\"M\"},\"fullName\":{\"code\":\"match\",\"value\":\"M\"},\"lastName\":{\"code\":\"match\",\"value\":\"M\"},\"result\":{\"code\":\"match-performed\",\"value\":\"M\"}},\"createdAt\":169297262323,\"cvv\":{\"code\":\"match\",\"value\":\"M\"},\"fees\":null,\"fingerprint\":\"WUlcOAgQcTN1GEUaoaKrLH1wL2PZrjsUS7byUGZyUEA\",\"id\":\"card_insight_1234567890\",\"paymentAccountReference\":\"V0010011111111111111111111111\"}}},\"schema\":{\"example\":{\"address\":{\"avsIdentifier\":\"aBcdeFGhIJKlmnoPqR\",\"networkIdentifier\":\"1234567890\",\"networkResponseCode\":{\"value\":\"85\"},\"result\":{\"address\":\"match\",\"value\":\"Y\",\"zip\":\"match\"}},\"bin\":{\"brand\":\"visa\",\"country\":\"us\",\"currency\":\"usd\",\"fastFunds\":{\"crossBorder\":true,\"domestic\":true},\"funding\":\"credit\",\"issuer\":\"Gringotts Wizarding Bank and Trust Company\",\"productName\":\"Visa Credit\",\"segment\":\"consumer\",\"threeDS\":{\"acsInfoIndicators\":[{\"code\":\"acs-auth-available\",\"description\":\"Authentication Available at ACS\",\"indicator\":\"01\"}],\"supportedVersions\":{\"accessControlServer\":[\"2.2.0\"],\"directoryServer\":[\"2.2.0\",\"2.3.1\"]}},\"type\":\"card\"},\"capabilities\":{\"pull\":{\"country\":{\"alphaCode\":\"us\",\"numericCode\":\"840\"},\"currency\":{\"alphaCode\":\"usd\",\"numericCode\":\"840\"},\"enabled\":true,\"network\":\"visa\",\"regulated\":true,\"type\":\"credit\"},\"push\":{\"availability\":\"immediate\",\"country\":{\"alphaCode\":\"us\",\"numericCode\":\"840\"},\"currency\":{\"alphaCode\":\"usd\",\"numericCode\":\"840\"},\"enabled\":true,\"network\":\"visa\",\"regulated\":true,\"type\":\"credit\"}},\"cardholder\":{\"firstName\":{\"code\":\"match\",\"value\":\"M\"},\"fullName\":{\"code\":\"match\",\"value\":\"M\"},\"lastName\":{\"code\":\"match\",\"value\":\"M\"},\"result\":{\"code\":\"match-performed\",\"value\":\"M\"}},\"createdAt\":169297262323,\"cvv\":{\"code\":\"match\",\"value\":\"M\"},\"fees\":null,\"fingerprint\":\"WUlcOAgQcTN1GEUaoaKrLH1wL2PZrjsUS7byUGZyUEA\",\"id\":\"card_insight_1234567890\",\"paymentAccountReference\":\"V0010011111111111111111111111\"},\"properties\":{\"address\":{\"properties\":{\"avsIdentifier\":{\"description\":\"A unique identifier generated for this AVS verification\",\"example\":\"aBcdeFGhIJKlmnoPqR\",\"type\":\"string\"},\"networkIdentifier\":{\"description\":\"A network generated transaction identifier that is unique to every authorization and financial request.\",\"example\":\"1234567890\",\"type\":\"string\"},\"networkResponseCode\":{\"description\":\"Network response code returned when an authorization fails at the network or beyond\",\"properties\":{\"value\":{\"description\":\"The raw network response code\",\"example\":\"85\",\"type\":\"string\"}},\"type\":\"object\"},\"result\":{\"description\":\"The result of the address verification check (AVS)\",\"properties\":{\"address\":{\"description\":\"The match code for the address portion of the AVS (excludes zip code)\",\"enum\":[\"match\",\"no-match\",\"unknown\",\"unavailable\"],\"type\":\"string\"},\"value\":{\"description\":\"The raw result code\",\"example\":\"Y\",\"type\":\"string\"},\"zip\":{\"description\":\"The match code for the zip code portion of the address (excludes line1, line2, etc.)\",\"enum\":[\"match\",\"no-match\",\"unknown\",\"unavailable\"],\"type\":\"string\"}},\"type\":\"object\"}},\"summary\":\"The result of the address verification check (AVS)\",\"type\":\"object\"},\"bin\":{\"description\":\"The BIN details for the supplied card. This includes details such as the card brand, funding type, issuer, 3D Secure support and more.\",\"properties\":{\"brand\":{\"description\":\"The card brand associated with the payment card.\",\"enum\":[\"visa\",\"mastercard\",\"american-express\",\"discover\",\"diners-club\",\"jcb\",\"unionpay\"],\"example\":\"visa\",\"type\":\"string\"},\"country\":{\"description\":\"The country associated with the card.\",\"example\":\"us\",\"format\":\"iso-3166-1-alpha-2\",\"type\":\"string\"},\"currency\":{\"description\":\"The currency associated with the card (ISO 4217)\",\"example\":\"usd\",\"type\":\"string\"},\"fastFunds\":{\"description\":\"Specifies the availability of instant payment capabilities for card transactions,\\nindicating whether funds can be transferred immediately both within the same country\\nand across international borders.\\n\",\"properties\":{\"crossBorder\":{\"description\":\"When true, indicates that instant payments are supported for international\\ntransactions between different countries. This enables immediate funds\\navailability for cross-border transfers.\\n\",\"type\":\"boolean\"},\"domestic\":{\"description\":\"When true, indicates that instant payments are supported for transactions\\nwithin the same country/domestic market. This allows for immediate funds\\navailability for local transfers.\\n\",\"type\":\"boolean\"}},\"summary\":\"Fast Funds\",\"type\":\"object\"},\"funding\":{\"description\":\"The card funding type specifies the method by which transactions are\\nfinanced.\\n\",\"enum\":[\"debit\",\"credit\",\"prepaid\",\"deferred-debit\",\"charge\"],\"example\":\"debit\",\"type\":\"string\"},\"issuer\":{\"description\":\"The name of the issuer bank\",\"example\":\"Gringotts Wizarding Bank and Trust Company\",\"type\":\"string\"},\"productName\":{\"description\":\"The name of the product associated with the card\",\"example\":\"Visa Debit\",\"type\":\"string\"},\"segment\":{\"description\":\"The card segment indicates the primary market or usage category of the\\ncard.\\n\",\"enum\":[\"consumer\",\"commercial\",\"business\",\"government\",\"payouts\",\"all\"],\"example\":\"consumer\",\"type\":\"string\"},\"threeDS\":{\"description\":\"Metadata about 3DS capabilities, including supported versions \\nand ACS (Access Control Server) indicators.\\n\",\"properties\":{\"acsInfoIndicators\":{\"description\":\"Array of ACS information indicators\",\"items\":{\"properties\":{\"code\":{\"description\":\"The indicator code, the following values are supported:\\n\\n- `authentication-available`\\n- `attempts-supported`\\n- `decoupled-authentication-supported`\\n- `trustlist-supported`\\n- `device-binding-supported`\\n- `webauthn-authentication-supported`\\n- `spc-authentication-supported`\\n- `tra-exemption-supported`\\n- `trustlist-exemption-supported`\\n- `low-value-exemption-supported`\\n- `secure-corporate-payments-exemption-supported`\\n- `emvco-reserved`\\n- `ds-reserved`\\n\\n**American Express only:**\\n- `issuer-tra-exemption-supported`\\n- `issuer-trustlist-exemption-supported`\\n- `issuer-low-value-exemption-supported`\\n- `issuer-secure-corporate-payments-exemption-supported`\\n- `bridging-message-extension-supported`\\n\\n**Mastercard only:**\\n- `smart-auth-direct-stand-in-only`\\n- `smart-auth-direct`\\n- `payment-transactions-supported`\\n- `non-payment-transactions-supported`\\n- `app-channel-supported`\\n- `browser-channel-supported`\\n- `app-acs-challenge-supported`\\n- `browser-acs-challenge-supported`\\n\\n**Visa only:**\\n- `issuer-tra-exemption-supported`\\n- `data-only-supported`\\n- `delegated-authentication-supported`\\n- `digital-auth-framework-supported`\\n\",\"type\":\"string\"},\"description\":{\"description\":\"Human-readable description of the indicator\",\"type\":\"string\"},\"indicator\":{\"description\":\"The raw numeric indicator value, ranges from 01 to 99\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"supportedVersions\":{\"description\":\"The 3DS versions supported by the ACS and DS\",\"properties\":{\"accessControlServer\":{\"items\":{\"description\":\"Array of 3DS versions supported by the Access Control Server\",\"example\":\"2.2.0\",\"type\":\"string\"},\"type\":\"array\"},\"directoryServer\":{\"items\":{\"description\":\"Array of 3DS versions supported by the Directory Server\",\"example\":\"2.3.1\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}},\"summary\":\"3DS\",\"type\":\"object\"},\"type\":{\"description\":\"Type of card or network token identified during the lookup.\",\"enum\":[null,\"card\",\"network-token\"],\"example\":null,\"type\":[\"null\",\"string\"]}},\"type\":\"object\"},\"capabilities\":{\"description\":\"The push and pull capabilities of the card\",\"properties\":{\"pull\":{\"properties\":{\"availability\":{\"description\":\"Indicates the typical time for payouts\",\"enum\":[\"immediate\",\"next-day\",\"next-few\"],\"type\":\"string\"},\"country\":{\"description\":\"The country the card is issued in\",\"properties\":{\"alphaCode\":{\"description\":\"The ISO 3166-1 two character alphabetic code for the country\",\"example\":\"us\",\"type\":\"string\"},\"numericCode\":{\"description\":\"The ISO 3166-1 three digit code for the country\",\"example\":\"840\",\"type\":\"string\"}},\"type\":\"object\"},\"currency\":{\"description\":\"The currency of the card\",\"properties\":{\"alphaCode\":{\"description\":\"The ISO 4217 alphabetic code for the currency\",\"example\":\"usd\",\"type\":\"string\"},\"numericCode\":{\"description\":\"The ISO 4217 numeric code for the currency\",\"example\":\"840\",\"type\":\"string\"}},\"type\":\"object\"},\"enabled\":{\"description\":\"Indicates if push or pull transactions are enabled for the supplied card\",\"example\":true,\"type\":\"boolean\"},\"network\":{\"description\":\"The card network for the supplied card\",\"example\":\"visa\",\"type\":\"string\"},\"regulated\":{\"description\":\"Indicates if the issuer is a regulated institution\",\"example\":true,\"type\":\"boolean\"},\"type\":{\"description\":\"The funding type of the card\",\"example\":\"credit\",\"type\":\"string\"}},\"summary\":\"The push or pull capability of the card.\",\"type\":\"object\"},\"push\":{\"properties\":{\"availability\":{\"description\":\"Indicates the typical time for payouts\",\"enum\":[\"immediate\",\"next-day\",\"next-few\"],\"type\":\"string\"},\"country\":{\"description\":\"The country the card is issued in\",\"properties\":{\"alphaCode\":{\"description\":\"The ISO 3166-1 two character alphabetic code for the country\",\"example\":\"us\",\"type\":\"string\"},\"numericCode\":{\"description\":\"The ISO 3166-1 three digit code for the country\",\"example\":\"840\",\"type\":\"string\"}},\"type\":\"object\"},\"currency\":{\"description\":\"The currency of the card\",\"properties\":{\"alphaCode\":{\"description\":\"The ISO 4217 alphabetic code for the currency\",\"example\":\"usd\",\"type\":\"string\"},\"numericCode\":{\"description\":\"The ISO 4217 numeric code for the currency\",\"example\":\"840\",\"type\":\"string\"}},\"type\":\"object\"},\"enabled\":{\"description\":\"Indicates if push or pull transactions are enabled for the supplied card\",\"example\":true,\"type\":\"boolean\"},\"network\":{\"description\":\"The card network for the supplied card\",\"example\":\"visa\",\"type\":\"string\"},\"regulated\":{\"description\":\"Indicates if the issuer is a regulated institution\",\"example\":true,\"type\":\"boolean\"},\"type\":{\"description\":\"The funding type of the card\",\"example\":\"credit\",\"type\":\"string\"}},\"summary\":\"The push or pull capability of the card.\",\"type\":\"object\"}},\"type\":\"object\"},\"cardholder\":{\"properties\":{\"firstName\":{\"description\":\"The result\",\"properties\":{\"code\":{\"description\":\"A human readable version of the ANI match code\",\"enum\":[\"match\",\"partial-match\",\"no-match\"],\"type\":\"string\"},\"value\":{\"description\":\"The raw match code returned for the ANI check for the first name\",\"enum\":[\"M\",\"P\",\"N\"],\"type\":\"string\"}},\"type\":\"object\"},\"fullName\":{\"description\":\"The result\",\"properties\":{\"code\":{\"description\":\"A human readable version of the ANI match code\",\"enum\":[\"match\",\"partial-match\",\"no-match\"],\"type\":\"string\"},\"value\":{\"description\":\"The raw match code returned for the ANI check for the full name\",\"enum\":[\"M\",\"P\",\"N\"],\"type\":\"string\"}},\"type\":\"object\"},\"lastName\":{\"description\":\"The result\",\"properties\":{\"code\":{\"description\":\"A human readable version of the ANI match code\",\"enum\":[\"match\",\"partial-match\",\"no-match\"],\"type\":\"string\"},\"value\":{\"description\":\"The raw match code returned for the ANI check for the last name\",\"enum\":[\"M\",\"P\",\"N\"],\"type\":\"string\"}},\"type\":\"object\"},\"result\":{\"description\":\"The result\",\"properties\":{\"code\":{\"description\":\"A human readable version of the ANI result code\",\"enum\":[\"match-performed\",\"no-match-performed\",\"unsupported\"],\"type\":\"string\"},\"value\":{\"description\":\"The raw result code returned for the ANI check\",\"enum\":[\"M\",\"N\",\"U\"],\"type\":\"string\"}},\"type\":\"object\"}},\"summary\":\"The result of the name verification (ANI)\",\"type\":\"object\"},\"createdAt\":{\"description\":\"Unix timestamp of when the card insight was created\",\"example\":169297262323,\"type\":\"integer\"},\"cvv\":{\"description\":\"The result of the CVV verification check\",\"properties\":{\"code\":{\"description\":\"A human readable version of the CVV match code\",\"example\":\"match\",\"type\":\"string\"},\"value\":{\"description\":\"The raw match code returned from the CVV verification check\",\"example\":\"Y\",\"type\":\"string\"}},\"type\":\"object\"},\"fees\":{\"deprecated\":true,\"description\":\"Deprecated. Always returns `null`. Previously the estimated network and interchange fees for push and pull transactions.\",\"type\":\"null\"},\"fingerprint\":{\"description\":\"A unique, cryptographically secure identifier for the card number. Useful for deduplication.\",\"example\":\"WUlcOAgQcTN1GEUaoaKrLH1wL2PZrjsUS7byUGZyUEA\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier for the Card Insight\",\"example\":\"card_insight_1234567890\",\"type\":\"string\"},\"paymentAccountReference\":{\"description\":\"The unique identifier of the Payment Account associated with this card.\",\"example\":\"512381d9f8e0629211e3949a08002\",\"type\":\"string\"}},\"required\":[\"id\",\"fingerprint\",\"bin\",\"createdAt\"],\"summary\":\"The Card Insight Object\",\"type\":\"object\"}}},\"description\":\"Returns the Card Insight object\"}},\"security\":[{\"ApiKey\":[\"insights:create\"]}],\"securitySchemes\":{\"ApiKey\":{\"description\":\"Authentication using an API key. The username is the App ID and the password is the Api Key.\",\"scheme\":\"basic\",\"type\":\"http\"},\"ClientSideToken\":{\"bearerFormat\":\"Token\",\"description\":\"Authentication using a short lived token that you can share with clients. The Authorization header must be formatted as follow: \\\"Token <Client-Side Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"},\"TokenAuth\":{\"bearerFormat\":\"RunToken\",\"description\":\"Authentication using a short lived run token that you can share with clients. The Authorization header must be formatted as follow: \\\"RunToken <Function Run Token>\\\"\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
