# BasicNetworkTokenFlow

main: kit: flow: BasicNetworkTokenFlow:
{
  entity: "network_token",
  kind: "basic",
  name: "BasicNetworkTokenFlow",
  step: [
    {
      i: {
        ref: "network_token_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "network_token_ref01",
        srcdatavar: "network_token_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "network_token01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-network_token_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNetworkTokenFlow"
}