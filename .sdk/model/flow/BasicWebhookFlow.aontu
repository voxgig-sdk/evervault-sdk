# BasicWebhookFlow

main: kit: flow: BasicWebhookFlow:
{
  entity: "webhook",
  kind: "basic",
  name: "BasicWebhookFlow",
  step: [
    {
      i: {
        ref: "webhook_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "webhook_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "webhook_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "webhook01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "webhook_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWebhookFlow"
}