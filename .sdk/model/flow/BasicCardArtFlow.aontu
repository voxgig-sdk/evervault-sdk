# BasicCardArtFlow

main: kit: flow: BasicCardArtFlow:
{
  entity: "card_art",
  kind: "basic",
  name: "BasicCardArtFlow",
  step: [
    {
      input: {
        ref: "card_art_ref01",
        srcdatavar: "card_art_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "card_art01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-card_art_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCardArtFlow"
}