# BasicWebhookEndpointFlow

main: kit: flow: BasicWebhookEndpointFlow:
{
  entity: "webhook_endpoint",
  kind: "basic",
  name: "BasicWebhookEndpointFlow",
  step: [
    {
      input: {
        ref: "webhook_endpoint_ref01",
        srcdatavar: "webhook_endpoint_ref01_data",
        suffix: "_up0",
        textfield: "url"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhook_endpoint_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "webhook_endpoint_ref01",
        srcdatavar: "webhook_endpoint_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "webhook_endpoint01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhook_endpoint_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWebhookEndpointFlow"
}