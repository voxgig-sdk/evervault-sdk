# BasicNetworkTokenCryptogramFlow

main: kit: flow: BasicNetworkTokenCryptogramFlow:
{
  entity: "network_token_cryptogram",
  kind: "basic",
  name: "BasicNetworkTokenCryptogramFlow",
  step: [
    {
      input: {
        ref: "network_token_cryptogram_ref01"
      }

      match: {
        network_token_id: "network_token01"
      }

      op: "create"
    }
  ],
  "key$": "BasicNetworkTokenCryptogramFlow"
}