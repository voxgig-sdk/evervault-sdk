    }

    {
      input: {
        ref: "relay_ref01",
        srcdatavar: "relay_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "relay01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
