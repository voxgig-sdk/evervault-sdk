# BasicCoreFlow

main: kit: flow: BasicCoreFlow:
{
  entity: "core",
  kind: "basic",
  name: "BasicCoreFlow",
  step: [
    {
      input: {
        ref: "core_ref01"
      }

      match: {
        relay_id: "relay01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "core_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "core_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "core01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "core_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCoreFlow"
}